# =====================================================================
# AgentGrid configuration. Copy to `.env` (scripts/dev.py setup does this
# for you) and fill in the values you need. NEVER commit `.env`.
# Every value below has a safe default for local development unless
# marked REQUIRED IN PRODUCTION.
# =====================================================================

# ---- App -------------------------------------------------------------
APP_ENV=development                 # development | test | production
APP_NAME=AgentGrid
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
LOG_JSON=true                       # structured JSON logs (false = human readable)
WEB_CONCURRENCY=1                   # uvicorn workers (keep 1 locally; raise in production)
# Proxies allowed to set X-Forwarded-For (IPs/CIDRs). Set to your load balancer's
# range in production so per-IP rate limits cannot be bypassed with a fake header.
FORWARDED_ALLOW_IPS=127.0.0.1
HOST=0.0.0.0
PORT=8000

# ---- Security (REQUIRED IN PRODUCTION) -------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:8000,http://localhost:5173

# Bootstrap platform super admin (created by `python scripts/dev.py seed`)
SUPERADMIN_EMAIL=admin@agentgrid.dev
SUPERADMIN_PASSWORD=ChangeMe123!

# ---- Database --------------------------------------------------------
# Lite mode: paste your Neon / Supabase connection string here (any of the
#   postgres:// | postgresql:// | postgresql+asyncpg:// forms work; sslmode
#   is handled automatically).
# Full mode (Docker): postgresql+asyncpg://agentgrid:agentgrid@postgres:5432/agentgrid
# Zero-config fallback (no Postgres, NO vector index, dev/test only):
#   sqlite+aiosqlite:///./data/agentgrid.db
DATABASE_URL=postgresql+asyncpg://agentgrid:agentgrid@localhost:5432/agentgrid
DB_POOL_SIZE=5                      # keep small for Neon/Supabase free tiers
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_ECHO=false
# Set true when connecting through PgBouncer in transaction mode
# (e.g. Supabase pooler on port 6543). Auto-detected for common hosts.
DB_DISABLE_PREPARED_STATEMENTS=false

# ---- Redis -----------------------------------------------------------
# Lite mode: Upstash URL (rediss://default:<password>@<host>:6379)
# Full mode (Docker): redis://redis:6379/0
# Leave EMPTY to use an in-process fallback (single process only).
REDIS_URL=

# ---- Event bus -------------------------------------------------------
# Leave EMPTY to use the in-process event bus (lite mode).
# Full mode (Docker): redpanda:9092
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC_PREFIX=agentgrid

# ---- LLM providers (free tiers) --------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_NLU_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_NLU_MODEL=gemini-2.5-flash-lite
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOOL_ITERATIONS=5
LLM_HISTORY_MESSAGES=12
FAQ_CACHE_TTL_SECONDS=21600       # Redis cache for repeated FAQ answers

# ---- Rate limits & quotas (defaults; tenants can override) -----------
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=10
DEFAULT_MONTHLY_TOKEN_QUOTA=2000000
DEFAULT_RETENTION_DAYS=365

# ---- Uploads / RAG ---------------------------------------------------
UPLOAD_MAX_MB=10
MAX_CHUNKS_PER_DOCUMENT=400
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=.cache/fastembed
EMBEDDING_THREADS=2
# auto = pgvector on Postgres (Neon/Supabase/Docker); json = in-process cosine (no extension needed)
VECTOR_BACKEND=auto
CHUNK_SIZE_CHARS=900
CHUNK_OVERLAP_CHARS=150
RAG_TOP_K=4
RAG_MIN_SCORE=0.58                # below this retrieval score the assistant says "I don't know"

# ---- Channels --------------------------------------------------------
# WhatsApp Cloud API (Meta developer app -> WhatsApp -> API Setup)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Facebook Messenger
MESSENGER_VERIFY_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_PAGE_ACCESS_TOKEN=
# Tenant slug that receives WhatsApp/Messenger messages not mapped to a tenant (demo: sunrise-dental)
CHANNELS_DEFAULT_TENANT=
GRAPH_API_VERSION=v21.0

# ---- Notifications ---------------------------------------------------
# Email is sent only if SMTP_HOST is set; otherwise notifications are logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=AgentGrid <no-reply@agentgrid.dev>
SMTP_STARTTLS=true

# ---- Integrations (all optional; built-in CRM/calendar used otherwise) -
HUBSPOT_PRIVATE_APP_TOKEN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Observability (all optional) ------------------------------------
SENTRY_DSN=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true
