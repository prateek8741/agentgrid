# Normalize all text files to LF in the repository and working tree,
# so the project behaves identically on macOS, Linux and Windows.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.docx binary
*.woff binary
*.woff2 binary
*.onnx binary
